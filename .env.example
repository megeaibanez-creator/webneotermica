# Copia este archivo a .env.local y rellena los valores. NO commitear .env.local.

# Supabase (proyecto pendiente de crear).
# Sin estas variables:
#   · en desarrollo  -> leads y chats van a .data/*.jsonl (mismas columnas que el SQL)
#   · en producción  -> el formulario responde 503 y no finge que ha guardado
# Esquema listo para aplicar: supabase/migrations/0001_init.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL canónica del sitio
NEXT_PUBLIC_SITE_URL=https://www.neotermica.com

# Analítica (usar GA4 *o* GTM, nunca los dos)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# Asistente (chat) y embeddings del RAG. Sin clave, el chat responde con la
# ficha de empresa y deriva a teléfono / WhatsApp / formulario.
OPENAI_API_KEY=

# Correo IONOS (info@neotermica.es). Sin SMTP_PASS el lead se guarda y no se manda mail.
SMTP_HOST=smtp.ionos.es
SMTP_PORT=587
SMTP_USER=info@neotermica.es
SMTP_PASS=
SMTP_FROM=Neotérmica <info@neotermica.es>
MAIL_TO=info@neotermica.es
